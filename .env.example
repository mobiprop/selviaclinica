# Copy this file to .env.local and fill in real values. See SETUP.md for the
# full walkthrough of where each value comes from.

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never prefix this one with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- MCP Connection ----------------------------------------------------------
# Any long random string — generate one with: openssl rand -hex 24
MCP_API_KEY=

# --- Google Calendar / Google Drive ------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Meta Ads -----------------------------------------------------------------
NEXT_PUBLIC_META_APP_ID=
META_APP_SECRET=

# Base URL this app is reachable at — used to build OAuth redirect_uri values.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI Data ------------------------------------------------------------------
# Get one at console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
